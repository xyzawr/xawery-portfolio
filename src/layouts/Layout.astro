---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  isIndex?: boolean;
  activePage?: string;
}

const {
  title = 'xawery — designer',
  description = 'Graphic and web designer based in Warsaw. Brand identities, websites and visual systems.',
  ogImage = '/favicon.png',
  isIndex = false,
  activePage = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, 'https://xawery.com').href;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="xawery daniel" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
<div id="toast">copied to clipboard</div>

{isIndex ? (
  <div class="page">
    <nav>
      <a href="/" class="nav-logo">xawery</a>
      <ul class="nav-links">
        <li><a href="/work">work</a></li>
        <li><a href="/photography">photography</a></li>
        <li><a href="/about">about</a></li>
        <li><a href="/contact">contact</a></li>
      </ul>
      <button class="burger" id="burger" aria-label="menu">
        <span></span><span></span><span></span>
      </button>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
      <ul>
        <li><a href="/work">work</a></li>
        <li><a href="/photography">photography</a></li>
        <li><a href="/about">about</a></li>
        <li><a href="/contact">contact</a></li>
      </ul>
      <div class="mm-footer">
        <div class="footer-links">
          <a href="https://instagram.com/xawerydaniel" target="_blank" rel="noopener noreferrer">ig</a>
          <a href="https://www.behance.net/xawerydaniel" target="_blank" rel="noopener noreferrer">be</a>
          <a href="#" class="copy-mail">mail</a>
        </div>
        <div class="footer-right">
          <span class="footer-copy">&copy;2026</span>
        </div>
      </div>
    </div>

    <slot />

    <footer>
      <span class="footer-copy">xawery daniel &copy; 2026</span>
      <div class="footer-right">
        <a href="https://www.behance.net/xawerydaniel" target="_blank" rel="noopener noreferrer" rel="noopener noreferrer" class="footer-social"><i class="fa-brands fa-behance"></i></a>
        <a href="https://www.instagram.com/xawerydaniel" target="_blank" rel="noopener noreferrer" class="footer-social"><i class="fa-brands fa-instagram"></i></a>
        <a href="https://www.linkedin.com/in/ksawerydaniel/" target="_blank" rel="noopener noreferrer" class="footer-social"><i class="fa-brands fa-linkedin"></i></a>
      </div>
    </footer>
  </div>
) : (
  <>
    <nav>
      <a href="/" class="nav-logo">xawery</a>
      <ul class="nav-links">
        <li><a href="/work" class={activePage === 'work' ? 'active' : ''}>work</a></li>
        <li><a href="/photography" class={activePage === 'photography' ? 'active' : ''}>photography</a></li>
        <li><a href="/about" class={activePage === 'about' ? 'active' : ''}>about</a></li>
        <li><a href="/contact" class={activePage === 'contact' ? 'active' : ''}>contact</a></li>
      </ul>
      <button class="burger" id="burger" aria-label="menu">
        <span></span><span></span><span></span>
      </button>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
      <ul>
        <li><a href="/work">work</a></li>
        <li><a href="/photography">photography</a></li>
        <li><a href="/about">about</a></li>
        <li><a href="/contact">contact</a></li>
      </ul>
      <div class="mm-footer">
        <div class="footer-links">
          <a href="https://instagram.com/xawerydaniel" target="_blank" rel="noopener noreferrer">ig</a>
          <a href="https://www.behance.net/xawerydaniel" target="_blank" rel="noopener noreferrer">be</a>
          <a href="#" class="copy-mail">mail</a>
        </div>
        <div class="footer-right">
          <span class="footer-copy">&copy;2026</span>
        </div>
      </div>
    </div>

    <slot />

    <footer>
      <span class="footer-copy">xawery daniel &copy; 2026</span>
      <div class="footer-right">
        <a href="https://www.behance.net/xawerydaniel" target="_blank" rel="noopener noreferrer" rel="noopener noreferrer" class="footer-social"><i class="fa-brands fa-behance"></i></a>
        <a href="https://www.instagram.com/xawerydaniel" target="_blank" rel="noopener noreferrer" class="footer-social"><i class="fa-brands fa-instagram"></i></a>
        <a href="https://www.linkedin.com/in/ksawerydaniel/" target="_blank" rel="noopener noreferrer" class="footer-social"><i class="fa-brands fa-linkedin"></i></a>
      </div>
    </footer>
  </>
)}

<script src="/main.js" is:inline></script>

<!-- Cookie banner -->
<div id="cookie-banner">
  <p class="cookie-text">this site uses cookies to analyse traffic via google analytics.</p>
  <div class="cookie-btns">
    <button id="cookie-necessary">only necessary</button>
    <button id="cookie-accept">accept all</button>
  </div>
</div>

<script is:inline>
(function() {
  var consent = localStorage.getItem('cookie-consent');
  if (consent === 'all') { loadGA(); return; }
  if (consent === 'necessary') return;
  document.getElementById('cookie-banner').classList.add('visible');

  document.getElementById('cookie-accept').addEventListener('click', function() {
    localStorage.setItem('cookie-consent', 'all');
    document.getElementById('cookie-banner').classList.remove('visible');
    loadGA();
  });
  document.getElementById('cookie-necessary').addEventListener('click', function() {
    localStorage.setItem('cookie-consent', 'necessary');
    document.getElementById('cookie-banner').classList.remove('visible');
  });

  function loadGA() {
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=G-0L7HZDKK0S';
    document.head.appendChild(s);
    window.dataLayer = window.dataLayer || [];
    function gtag(){ window.dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', 'G-0L7HZDKK0S');
  }
})();
</script>
</body>
</html>
