---
export interface Props {
  title?: string;
  isIndex?: boolean;
  activePage?: string;
}

const { title = 'xawery — designer', isIndex = false, activePage = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
<div id="toast">copied to clipboard</div>

{isIndex ? (
  <div class="page">
    <nav>
      <a href="/" class="nav-logo">xawery</a>
      <ul class="nav-links">
        <li><a href="/work">work</a></li>
        <li><a href="/photography">photography</a></li>
        <li><a href="/about">about</a></li>
        <li><a href="/contact">contact</a></li>
      </ul>
      <button class="burger" id="burger" aria-label="menu">
        <span></span><span></span><span></span>
      </button>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
      <ul>
        <li><a href="/work">work</a></li>
        <li><a href="/photography">photography</a></li>
        <li><a href="/about">about</a></li>
        <li><a href="/contact">contact</a></li>
      </ul>
      <div class="mm-footer">
        <div class="footer-links">
          <a href="https://instagram.com/xawerydaniel" target="_blank">ig</a>
          <a href="https://www.behance.net/xawerydaniel" target="_blank">be</a>
          <a href="#" class="copy-mail">mail</a>
        </div>
        <div class="footer-right">
          <span class="footer-copy">&copy;2026</span>
        </div>
      </div>
    </div>

    <slot />

    <footer>
      <span class="footer-copy">xawery daniel &copy; 2026</span>
      <div class="footer-right">
        <a href="https://www.behance.net/xawerydaniel" target="_blank" class="footer-social"><i class="fa-brands fa-behance"></i></a>
        <a href="https://www.instagram.com/xawerydaniel" target="_blank" class="footer-social"><i class="fa-brands fa-instagram"></i></a>
        <a href="https://www.linkedin.com/in/ksawerydaniel/" target="_blank" class="footer-social"><i class="fa-brands fa-linkedin"></i></a>
      </div>
    </footer>
  </div>
) : (
  <>
    <nav>
      <a href="/" class="nav-logo">xawery</a>
      <ul class="nav-links">
        <li><a href="/work" class={activePage === 'work' ? 'active' : ''}>work</a></li>
        <li><a href="/photography" class={activePage === 'photography' ? 'active' : ''}>photography</a></li>
        <li><a href="/about" class={activePage === 'about' ? 'active' : ''}>about</a></li>
        <li><a href="/contact" class={activePage === 'contact' ? 'active' : ''}>contact</a></li>
      </ul>
      <button class="burger" id="burger" aria-label="menu">
        <span></span><span></span><span></span>
      </button>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
      <ul>
        <li><a href="/work">work</a></li>
        <li><a href="/photography">photography</a></li>
        <li><a href="/about">about</a></li>
        <li><a href="/contact">contact</a></li>
      </ul>
      <div class="mm-footer">
        <div class="footer-links">
          <a href="https://instagram.com/xawerydaniel" target="_blank">ig</a>
          <a href="https://www.behance.net/xawerydaniel" target="_blank">be</a>
          <a href="#" class="copy-mail">mail</a>
        </div>
        <div class="footer-right">
          <span class="footer-copy">&copy;2026</span>
        </div>
      </div>
    </div>

    <slot />

    <footer>
      <span class="footer-copy">xawery daniel &copy; 2026</span>
      <div class="footer-right">
        <a href="https://www.behance.net/xawerydaniel" target="_blank" class="footer-social"><i class="fa-brands fa-behance"></i></a>
        <a href="https://www.instagram.com/xawerydaniel" target="_blank" class="footer-social"><i class="fa-brands fa-instagram"></i></a>
        <a href="https://www.linkedin.com/in/ksawerydaniel/" target="_blank" class="footer-social"><i class="fa-brands fa-linkedin"></i></a>
      </div>
    </footer>
  </>
)}

<script src="/main.js" is:inline></script>
</body>
</html>
