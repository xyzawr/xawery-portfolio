---
import Layout from '../../layouts/Layout.astro';
import { sanityClient, imageUrl } from '../../sanity/client';

export async function getStaticPaths() {
  const projectId = import.meta.env.SANITY_PROJECT_ID;
  if (!projectId) return [];
  try {
    const trips = await sanityClient.fetch<Array<{ slug: { current: string } }>>(
      `*[_type == "trip"]{ slug }`
    );
    return trips.map((t) => ({ params: { slug: t.slug.current } }));
  } catch {
    return [];
  }
}

interface TripPhoto {
  _key?: string;
  asset?: { _ref?: string };
  alt?: string;
}

interface Trip {
  _id: string;
  name: string;
  slug: { current: string };
  year?: number;
  location?: string;
  coverImage?: { asset?: { _ref?: string } };
  photos?: TripPhoto[];
}

const { slug } = Astro.params;
let trip: Trip | null = null;

try {
  const projectId = import.meta.env.SANITY_PROJECT_ID;
  if (projectId && slug) {
    trip = await sanityClient.fetch<Trip>(
      `*[_type == "trip" && slug.current == $slug][0]{
        _id, name, slug, year, location, coverImage,
        photos[]{ _key, asset, alt }
      }`,
      { slug }
    );
  }
} catch { /* fall through */ }

if (!trip) return Astro.redirect('/photography');

const coverSrc = imageUrl(trip.coverImage, { w: 1400, q: 90 });
const ogImage = imageUrl(trip.coverImage, { w: 1200, q: 85 });
const photos: TripPhoto[] = trip.photos || [];
const MAX_THUMBS = 8;
const shownThumbs = photos.slice(0, MAX_THUMBS);
const extraCount = photos.length > MAX_THUMBS ? photos.length - MAX_THUMBS + 1 : 0;
---

<Layout
  title={`xawery — ${trip.name}`}
  description={`${trip.name}${trip.location ? ` — ${trip.location}` : ''}${trip.year ? `, ${trip.year}` : ''}. Photography by xawery daniel.`}
  ogImage={ogImage || undefined}
  activePage="photography"
>
  <!-- Lightbox -->
  <div class="cover-lb" id="cover-lb">
    <div class="lb-controls">
      <button class="lb-toggle" id="cover-lb-toggle">◐ light</button>
      <button class="lb-close" id="cover-lb-close">&#x2715; close</button>
    </div>
    <button class="lb-nav lb-prev" id="cover-lb-prev" aria-label="previous">&larr;</button>
    <div class="cover-lb-img" id="cover-lb-img">
      {coverSrc && <img src={coverSrc} alt={trip.name} />}
    </div>
    <button class="lb-nav lb-next" id="cover-lb-next" aria-label="next">&rarr;</button>
    <span class="lb-counter" id="cover-lb-counter"></span>
  </div>

  <div class="project-wrap">
    <div class="project-cover-ph" id="cover-ph">
      {coverSrc ? (
        <img src={coverSrc} alt={trip.name} />
      ) : (
        trip.name.slice(0, 2).toUpperCase()
      )}
      <button class="cover-arrow cover-prev">&larr;</button>
      <button class="cover-arrow cover-next">&rarr;</button>
    </div>

    <div class="cover-thumbs" id="cover-thumbs">
      {coverSrc && (
        <div class="cover-thumb active" data-index={0} data-src={coverSrc}>
          <img src={coverSrc} alt={trip.name} style="width:100%;height:100%;object-fit:cover" />
        </div>
      )}
      {shownThumbs.map((p, i) => {
        const src = imageUrl(p, { w: 1400, q: 90 });
        const idx = coverSrc ? i + 1 : i;
        return (
          <div
            class={`cover-thumb${i === MAX_THUMBS - 1 && extraCount > 0 ? ' cover-thumb-more' : ''}`}
            data-index={idx}
            data-src={src}
          >
            {i === MAX_THUMBS - 1 && extraCount > 0 ? (
              `+${extraCount}`
            ) : src ? (
              <img src={src} alt={p.alt || ''} loading="lazy" style="width:100%;height:100%;object-fit:cover" />
            ) : null}
          </div>
        );
      })}
    </div>

    <div class="project-info">
      <div class="project-header">
        <h1 class="project-name">{trip.name}</h1>
        <div class="project-nav">
          <a href="/photography" class="project-nav-btn">&larr;</a>
        </div>
      </div>
      <div class="about-meta">
        {trip.year && (
          <div class="about-row">
            <span class="about-row-label">year</span>
            <span class="about-row-val">{trip.year}</span>
          </div>
        )}
        {trip.location && (
          <div class="about-row">
            <span class="about-row-label">location</span>
            <span class="about-row-val">{trip.location}</span>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
const allImages: string[] = [];
document.querySelectorAll('.cover-thumb[data-src]').forEach(t => {
  allImages.push((t as HTMLElement).dataset.src || '');
});

const lb = document.getElementById('cover-lb')!;
const lbImg = document.getElementById('cover-lb-img')!;
const lbCounter = document.getElementById('cover-lb-counter')!;
const lbToggle = document.getElementById('cover-lb-toggle')!;
const thumbEls = Array.from(document.querySelectorAll('.cover-thumb'));
let current = 0;

function goTo(n: number) {
  current = ((n % Math.max(allImages.length, 1)) + Math.max(allImages.length, 1)) % Math.max(allImages.length, 1);
  thumbEls.forEach((t, i) => t.classList.toggle('active', i === current));
  const src = allImages[current];
  const coverImg = document.querySelector('#cover-ph > img') as HTMLImageElement | null;
  if (coverImg && src) coverImg.src = src;
  lbImg.innerHTML = '';
  if (src) {
    const img = document.createElement('img');
    img.src = src;
    lbImg.appendChild(img);
  }
  lbCounter.textContent = (current + 1) + ' / ' + allImages.length;
}

thumbEls.forEach((t, i) => t.addEventListener('click', () => goTo(i)));
document.querySelector('.cover-prev')?.addEventListener('click', () => goTo(current - 1));
document.querySelector('.cover-next')?.addEventListener('click', () => goTo(current + 1));

document.getElementById('cover-ph')?.addEventListener('click', (e) => {
  if ((e.target as HTMLElement).classList.contains('cover-arrow')) return;
  goTo(current);
  lb.classList.add('open');
});
document.getElementById('cover-lb-close')?.addEventListener('click', () => lb.classList.remove('open'));
document.getElementById('cover-lb-prev')?.addEventListener('click', () => goTo(current - 1));
document.getElementById('cover-lb-next')?.addEventListener('click', () => goTo(current + 1));
lbToggle.addEventListener('click', () => {
  lb.classList.toggle('lb-light');
  lbToggle.textContent = lb.classList.contains('lb-light') ? '◐ dark' : '◐ light';
});
lb.addEventListener('click', e => { if (e.target === lb) lb.classList.remove('open'); });
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') lb.classList.remove('open');
  if (e.key === 'ArrowLeft') goTo(current - 1);
  if (e.key === 'ArrowRight') goTo(current + 1);
});
</script>
