---
import Layout from '../layouts/Layout.astro';
---

<Layout title="xawery — about" description="Graphic and web designer based in Warsaw. Currently designing for Red Bull. Open for freelance collaborations." activePage="about">
  <div class="about-wrap">
    <div class="about-photo">
      <h1 class="page-title">about</h1>
      <div class="about-photo-ph"><img src="/me.jpg" alt="xawery daniel" /></div>
    </div>
    <div class="about-text">
      <h1 class="about-name">xawery daniel</h1>
      <div class="about-meta">
        <div class="about-row">
          <span class="about-row-label">based</span>
          <span class="about-row-val"><span class="pin-icon"></span>Warsaw, Poland</span>
        </div>
        <div class="about-row">
          <span class="about-row-label">currently</span>
          <span class="about-row-val"><span class="status-dot"></span>Designing for Red Bull</span>
        </div>
        <div class="about-row">
          <span class="about-row-label">status</span>
          <span class="about-row-val"><span class="status-ring"></span>Open for freelance collaborations</span>
        </div>
      </div>
      <p class="about-bio"><strong>Graphic and web designer based in&nbsp;Warsaw.</strong><br />I&nbsp;create brand identities, websites and visual systems that are precise, intentional and built to&nbsp;last. I&nbsp;believe good design is invisible — it communicates clearly, feels inevitable, and&nbsp;holds up over time.<br /><br />My work sits at the intersection of&nbsp;strategy and&nbsp;craft. I&nbsp;work closely with clients to understand what they need to say, then find the clearest visual way to&nbsp;say&nbsp;it.<br /><br />When I&rsquo;m not designing, I&nbsp;experiment with generative visuals in&nbsp;Touch Designer and spend time behind a&nbsp;camera.</p>
      {/* TODO: add cv.pdf to /public when ready */}
      {false && <a href="/cv.pdf" download class="cv-download">download cv &darr;</a>}
    </div>
  </div>
</Layout>
