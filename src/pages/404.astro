---
import Layout from '../layouts/Layout.astro';
---

<Layout title="xawery — 404">
  <div class="not-found">
    <p class="not-found-code">404</p>
    <h1 class="not-found-msg">page not found.</h1>
    <a href="/" class="not-found-link">← go back home</a>
  </div>
</Layout>

<style>
.not-found {
  min-height: 70vh;
  display: flex; flex-direction: column;
  align-items: flex-start; justify-content: center;
  padding: var(--gap);
}
.not-found-code {
  font-size: .65rem; font-weight: 700;
  letter-spacing: .22em; text-transform: uppercase;
  color: var(--ink-dim); margin-bottom: 1rem;
}
.not-found-msg {
  font-size: clamp(2.5rem, 6vw, 5rem);
  font-weight: 700; margin-bottom: 2rem;
}
.not-found-link {
  font-size: .75rem; font-weight: 500;
  letter-spacing: .1em; text-transform: uppercase;
  color: var(--ink-dim); text-decoration: none;
  transition: color .15s;
}
.not-found-link:hover { color: var(--ink); }
</style>
